{
  "name": "soul-ds",
  "version": "1.1.0",
  "private": true,
  "description": "Camada legível por IA do Soul DS — dados em data/*.json, CSS e SVGs gerados em dist/. Componentes React em componentes/*.",
  "type": "module",
  "scripts": {
    "verify": "npm run verify:icons && npm run verify:components && npm run verify:tokens",
    "verify:icons": "node scripts/verify-icons.mjs",
    "verify:components": "node scripts/verify-components.mjs",
    "verify:tokens": "node scripts/verify-tokens.mjs",
    "test": "npm run test:validate && npm run test:migrate",
    "test:validate": "node scripts/test-validate.mjs",
    "test:migrate": "node scripts/test-migrate-spacing.mjs",
    "build": "node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "ci": "npm run verify && npm run build && npm run test && npm run typecheck",
    "find-icon": "node scripts/find-icon.mjs",
    "validate": "node scripts/validate.mjs",
    "sync:icons": "node scripts/sync-icons.mjs",
    "sync:check-drift": "node scripts/check-components-drift.mjs",
    "migrate:spacing": "node scripts/migrate-spacing-refs.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "figma:publish": "figma connect publish",
    "figma:unpublish": "figma connect unpublish"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.3.1",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "storybook": "^8.4.7",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
